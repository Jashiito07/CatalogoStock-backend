# Variables de entorno de CatalogoStock-backend.
# Copie este archivo como .env y reemplace los valores. Todos son FALSOS.
# Nunca suba .env a Git. Salvo las marcadas como opcionales, todas las
# variables son obligatorias: la API no arranca si falta alguna o tiene un
# valor inválido.

# --- Servidor HTTP ---
# Puerto en el que escucha la API (1-65535).
PUERTO=3000
# Orígenes permitidos por CORS, separados por comas (panel web y app móvil).
CORS_ORIGENES=http://localhost:4200,http://localhost:8100,capacitor://localhost

# --- PostgreSQL (fuente oficial de datos, RN-11) ---
# También los usa docker-compose.yml para crear la base de desarrollo.
BD_HOST=localhost
BD_PUERTO=5432
BD_NOMBRE=catalogostock
BD_USUARIO=catalogostock_usuario
BD_CLAVE=cambie_esta_clave_falsa

# --- Seguridad de claves (RNF-02, D-08) ---
# Opcional. Costo de bcrypt para el hash de las claves (entero de 10 a 14).
# Si no se define vale 12, el valor aprobado.
BCRYPT_COSTO=12

# --- Sesión y tokens (RF-USU-01, D-08, D-09) ---
# Secreto con el que se firman los tokens de acceso (JWT HS256). Obligatorio,
# de al menos 32 caracteres ALEATORIOS. Genere uno con:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
# Si cambia, los tokens de acceso ya emitidos dejan de valer y las apps renuevan la sesión.
JWT_SECRETO=cambie_este_secreto_falso_de_al_menos_32_caracteres
# Opcional. Vida del token de acceso en segundos (60 a 3600; por defecto 900 = 15 min).
JWT_VIDA_ACCESO_SEGUNDOS=900
# Opcional. Vida del token de renovación en días (1 a 30; por defecto 7).
RENOVACION_VIDA_DIAS=7

# --- Recuperación de clave (RF-USU-05, D-35) ---
# Secreto del HMAC-SHA256 con el que se guarda el hash de los códigos de
# recuperación (el código nunca se guarda). Obligatorio, de al menos 32
# caracteres ALEATORIOS y distinto de JWT_SECRETO. Genere uno con:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
# Si cambia, los códigos de recuperación vigentes dejan de servir.
RECUPERACION_SECRETO=cambie_este_otro_secreto_falso_de_al_menos_32_caracteres

# --- Proxy (D-17) ---
# Opcional. Número de proxies de confianza delante de la API (0 a 5; por
# defecto 0). Con 0 se ignora X-Forwarded-For y el límite de intentos usa la
# IP de la conexión. En producción, detrás de un proxy TLS, use 1.
PROXY_SALTOS_CONFIABLES=0

# --- Vendedor semilla: solo para `npm run crear-vendedor` (D-07, PA-09) ---
# La API no las necesita. El comando crea el único Vendedor si aún no existe
# ninguno; si ya existe, no cambia nada. Se recomienda definirlas solo en la
# sesión de la terminal al ejecutar el comando y no dejarlas en .env.
# Teléfono: celular de Ecuador, 09XXXXXXXX o +5939XXXXXXXX (D-14).
# Clave: 8 a 72 caracteres, con letras y números, y como máximo 72 bytes en
# UTF-8 (las tildes y la ñ ocupan 2 bytes; D-22).
VENDEDOR_NOMBRE=Nombre del Vendedor
VENDEDOR_CORREO=vendedor@ejemplo.test
VENDEDOR_TELEFONO=0990000000
VENDEDOR_CLAVE=cambie_esta_clave_falsa1

# --- Restablecer la clave del Vendedor: `npm run restablecer-clave-vendedor` (D-35) ---
# VENDEDOR_CLAVE_NUEVA no se escribe aquí: defínala solo en la terminal en la
# que ejecuta el comando (mismas reglas de la clave que VENDEDOR_CLAVE):
#   $env:VENDEDOR_CLAVE_NUEVA = 'ClaveNueva2026'   # PowerShell
#   npm run restablecer-clave-vendedor
#   Remove-Item Env:VENDEDOR_CLAVE_NUEVA

# --- Archivos del servidor (D-46) ---
# Opcional. Carpeta donde la API guarda archivos; las imagenes de productos
# van en <ruta>/productos/ con nombre UUID. Por defecto ./almacenamiento
# (ya esta en .gitignore: nunca se sube a Git). Debe poder escribirla solo la
# API y conviene incluirla en las copias de seguridad.
RUTA_ALMACENAMIENTO=./almacenamiento
