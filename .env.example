# Variables de entorno de CatalogoStock-backend.
# Copie este archivo como .env y reemplace los valores. Todos son FALSOS.
# Nunca suba .env a Git. Salvo las marcadas como opcionales, todas las
# variables son obligatorias: la API no arranca si falta alguna o tiene un
# valor inválido.

# --- Servidor HTTP ---
# Puerto en el que escucha la API (1-65535).
PUERTO=3000
# Orígenes permitidos por CORS, separados por comas (panel web y app móvil).
CORS_ORIGENES=http://localhost:4200,http://localhost:8100,capacitor://localhost

# --- PostgreSQL (fuente oficial de datos, RN-11) ---
# También los usa docker-compose.yml para crear la base de desarrollo.
BD_HOST=localhost
BD_PUERTO=5432
BD_NOMBRE=catalogostock
BD_USUARIO=catalogostock_usuario
BD_CLAVE=cambie_esta_clave_falsa

# --- Seguridad de claves (RNF-02, D-08) ---
# Opcional. Costo de bcrypt para el hash de las claves (entero de 10 a 14).
# Si no se define vale 12, el valor aprobado.
BCRYPT_COSTO=12

# --- Vendedor semilla: solo para `npm run crear-vendedor` (D-07, PA-09) ---
# La API no las necesita. El comando crea el único Vendedor si aún no existe
# ninguno; si ya existe, no cambia nada. Se recomienda definirlas solo en la
# sesión de la terminal al ejecutar el comando y no dejarlas en .env.
# Teléfono: celular de Ecuador, 09XXXXXXXX o +5939XXXXXXXX (D-14).
# Clave: 8 a 72 caracteres, con letras y números, y como máximo 72 bytes en
# UTF-8 (las tildes y la ñ ocupan 2 bytes; D-22).
VENDEDOR_NOMBRE=Nombre del Vendedor
VENDEDOR_CORREO=vendedor@ejemplo.test
VENDEDOR_TELEFONO=0990000000
VENDEDOR_CLAVE=cambie_esta_clave_falsa1
